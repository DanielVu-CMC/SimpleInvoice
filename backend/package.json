{
  "name": "simpleinvoice-api",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "migration:run": "ts-node src/database/migrate.ts",
    "seed": "node scripts/run-seed.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.5",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.1",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "decimal.js": "10.6.0",
    "dotenv": "17.3.1",
    "helmet": "8.3.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.18",
    "@nestjs/testing": "11.2.5",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.5.0",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.0",
    "jest": "30.3.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "auth/**/*.ts",
      "invoices/**/*.ts"
    ],
    "coverageDirectory": "../coverage"
  },
  "overrides": {
    "multer": "2.3.0"
  }
}
