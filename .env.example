# Public demo values only. Run npm run setup to generate local DB/JWT secrets.
NODE_ENV=development
APP_PORT=3001
FRONTEND_PORT=5180
DATABASE_PORT=5432
DATABASE_USERNAME=simpleinvoice
DATABASE_PASSWORD=replace-with-a-database-password
DATABASE_NAME=simpleinvoice
DATABASE_URL=postgresql://simpleinvoice:replace-with-a-database-password@localhost:5432/simpleinvoice
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=3600
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5180
SEED_USER_EMAIL=reviewer@example.com
SEED_USER_PASSWORD=reviewer-demo-password
SEED_USER_NAME=Alex Morgan
VITE_API_URL=/api
VITE_PAGE_SIZE=10
API_PROXY_TARGET=http://localhost:3001
